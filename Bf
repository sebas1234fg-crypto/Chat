										mobHum.PlatformStand = true
									end
								end
							end
						end

						local platformPos = targetPart.Position + Vector3.new(0, 14, 0)
						levelHeadPlatform.Position = platformPos
						hrp.CFrame = CFrame.new(platformPos + Vector3.new(0, 3, 0))
						hrp.Velocity = Vector3.new(0, 0, 0)

						pcall(function()
							local remote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
							if remote then
								remote:InvokeServer("Attack")
							end
							VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
							task.wait(0.05)
							VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
						end)
					else
						if levelHeadPlatform and levelHeadPlatform.Parent then
							levelHeadPlatform:Destroy()
							levelHeadPlatform = nil
						end
					end
				end
			end)
		elseif FeatureStates.PumpkinFarm.enabled then
			pcall(function()
				local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if not hrp then return end

				local targetModel, targetPart, tType = getPumpkinOrJackTarget()
				if targetModel and targetPart then
