local function getCurrentPlayerLevel()
	local detectedLevel = nil
	pcall(function()
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			for _, gui in ipairs(playerGui:GetDescendants()) do
				if gui:IsA("TextLabel") then
					local textL = gui.Text:lower()
					if textL:find("level") or textL:find("nivel") then
						local num = textL:match("%d+")
						if num then
							detectedLevel = tonumber(num)
							break
						end
					end
				end
			end
		end

		if not detectedLevel then
			local dataFolder = LocalPlayer:FindFirstChild("Data")
			if dataFolder then
				for _, val in ipairs(dataFolder:GetChildren()) do
					local nameL = val.Name:lower()
					if nameL:find("level") or nameL:find("nivel") then
						if val:IsA("IntValue") or val:IsA("NumberValue") then
							detectedLevel = val.Value
							break
						end
					end
				end
			end
		end
	end)
	return detectedLevel or 1
end

local function getActiveQuestData()
	local currentLvl = getCurrentPlayerLevel()
	for _, data in ipairs(massiveQuestDictionary) do
		if currentLvl >= data.minLevel and currentLvl <= data.maxLevel then
			return data
		end
	end
	return massiveQuestDictionary[1]
end

local function hasActiveQuest()
	pcall(function()
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			local questGui = playerGui:FindFirstChild("Quest")
			if questGui and questGui.Enabled then return true end
		end
	end)
	return false
end

