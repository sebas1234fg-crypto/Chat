local visitedChests = {}

local function getClosestChest()
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end

	local closestChest = nil
	local shortestDist = math.huge

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") and (obj.Name:lower():find("chest") or obj.Name:lower():find("cofre")) then
			local chestPos = obj.Position
			local posKey = math.floor(chestPos.X) .. "," .. math.floor(chestPos.Y) .. "," .. math.floor(chestPos.Z)
			
			if obj.Parent and not visitedChests[posKey] then
				local dist = (chestPos - hrp.Position).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					closestChest = obj
				end
			end
		end
	end
	return closestChest
end

local levelHeadPlatform = nil
local blacklistedPumpkinPositions = {}

local function getTargetByMobName(mobName)
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil, nil end

	local bestTarget = nil
	local bestPart = nil
	local shortest = math.huge

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj ~= LocalPlayer.Character then
			if obj.Name:lower():find(mobName:lower()) then
				local hum = obj:FindFirstChildOfClass("Humanoid")
				local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("Head")
				if root and (not hum or hum.Health > 0) then
					local dist = (root.Position - hrp.Position).Magnitude
					if dist < shortest then
						shortest = dist
						bestTarget = obj
						bestPart = root
					end
				end
			end
		end
	end
	return bestTarget, bestPart
end

local function getPumpkinOrJackTarget()
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil, nil, "none" end

	local bestTarget = nil
	local bestPart = nil
	local targetType = "none"
	local shortest = math.huge

	for _, obj in ipairs(Workspace:GetDescendants()) do
		local nameL = obj.Name:lower()
		if nameL:find("pumpkin") or nameL:find("calabaza") or nameL:find("jack") then
			local root = nil
			if obj:IsA("Model") then
				root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("PrimaryPart") or obj:FindFirstChildOfClass("BasePart")
			elseif obj:IsA("BasePart") then
				root = obj
			end

			if root then
				local sizeMagnitude = root.Size.Magnitude
				local posKey = math.floor(root.Position.X) .. "," .. math.floor(root.Position.Y) .. "," .. math.floor(root.Position.Z)
				local isAbnormalSize = (sizeMagnitude < 1.2 or sizeMagnitude > 12)

				if not blacklistedPumpkinPositions[posKey] and not isAbnormalSize then
					local dist = (root.Position - hrp.Position).Magnitude
					if dist < shortest then
						shortest = dist
						bestTarget = obj
						bestPart = root
						targetType = nameL:find("jack") and "jack" or "ground"
					end
				end
			end
		end
	end

	return bestTarget, bestPart, targetType
end

