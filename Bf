	iconImg.Image = "rbxassetid://" .. category.icon
	iconImg.ImageColor3 = Color3.fromRGB(160, 160, 180)
	iconImg.Parent = mainBtn

	local subMenuFrame = Instance.new("Frame")
	subMenuFrame.Size = UDim2.new(1, 0, 0, (#category.subOptions * 24) + 4)
	subMenuFrame.Position = UDim2.new(0, 0, 0, 32)
	subMenuFrame.BackgroundTransparency = 1
	subMenuFrame.Visible = false
	subMenuFrame.ZIndex = 3
	subMenuFrame.Parent = categoryContainer

	local subLayout = Instance.new("UIListLayout")
	subLayout.SortOrder = Enum.SortOrder.LayoutOrder
	subLayout.Padding = UDim.new(0, 3)
	subLayout.Parent = subMenuFrame

	for _, subOpt in ipairs(category.subOptions) do
		local subBtn = Instance.new("TextButton")
		subBtn.Size = UDim2.new(1, -10, 0, 22)
		subBtn.Position = UDim2.new(0, 10, 0, 0)
		subBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
		subBtn.BackgroundTransparency = 0.4
		subBtn.BorderSizePixel = 0
		subBtn.ZIndex = 3
		subBtn.Text = "      " .. subOpt.name
		subBtn.TextColor3 = Color3.fromRGB(170, 170, 190)
		subBtn.TextSize = 10
		subBtn.Font = ThemeSettings.FontType
		subBtn.TextXAlignment = Enum.TextXAlignment.Left
		subBtn.Parent = subMenuFrame

		local subCorner = Instance.new("UICorner")
		subCorner.CornerRadius = UDim.new(0, 4)
		subCorner.Parent = subBtn

		local blueLine = Instance.new("Frame")
		blueLine.Size = UDim2.new(0, 3, 0, 10)
		blueLine.Position = UDim2.new(0, 5, 0.5, -5)
		blueLine.BackgroundColor3 = Color3.fromRGB(100, 100, 120)
		blueLine.BorderSizePixel = 0
		blueLine.ZIndex = 3
		blueLine.Parent = subBtn

		local lineCorner = Instance.new("UICorner")
		lineCorner.CornerRadius = UDim.new(0, 2)
		lineCorner.Parent = blueLine

		subBtn.MouseButton1Click:Connect(function()
			if activeSubBtn and activeLine then
				TweenService:Create(activeSubBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(170, 170, 190)}):Play()
				TweenService:Create(activeLine, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(100, 100, 120)}):Play()
			end

			activeSubBtn = subBtn
			activeLine = blueLine
			
			TweenService:Create(subBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
			TweenService:Create(blueLine, TweenInfo.new(0.2), {BackgroundColor3 = ThemeSettings.AccentColor}):Play()

			loadInteractiveUI(category.name, subOpt)
		end)
	end

	local isOpen = false
	mainBtn.MouseButton1Click:Connect(function()
		isOpen = not isOpen
		local targetHeight = isOpen and (34 + subMenuFrame.AbsoluteSize.Y) or 30
		subMenuFrame.Visible = true

		TweenService:Create(categoryContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(1, -4, 0, targetHeight)
		}):Play()

		if not isOpen then
			task.delay(0.25, function()
				if not isOpen then subMenuFrame.Visible = false end
			end)
		end
	end)
end

local isMinimized = false
minimizeBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	if isMinimized then
		TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 520, 0, 34)
		}):Play()
	else
		TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 520, 0, 350)
		}):Play()
	end
end)

