					local sizeMagnitude = targetPart.Size.Magnitude
					local posKey = math.floor(targetPos.X) .. "," .. math.floor(targetPos.Y) .. "," .. math.floor(targetPos.Z)

					if sizeMagnitude < 1.2 or sizeMagnitude > 12 then
						blacklistedPumpkinPositions[posKey] = true
						return
					end

					local dist = (targetPos - hrp.Position).Magnitude
					local travelTime = math.max(0.1, dist / (FeatureStates.PumpkinFarm.speed * 2.5))

					if tType == "ground" then
						local tween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))})
						tween:Play()
						tween.Completed:Wait()
						pcall(function() VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0) end)
						task.wait(0.05)
						pcall(function() VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0) end)
