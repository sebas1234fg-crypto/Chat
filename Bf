					elseif tType == "jack" then
						if not levelHeadPlatform or not levelHeadPlatform.Parent then
							levelHeadPlatform = Instance.new("Part")
							levelHeadPlatform.Name = "PersistentPlatformFloat"
							levelHeadPlatform.Size = Vector3.new(8, 1, 8)
							levelHeadPlatform.Anchored = true
							levelHeadPlatform.CanCollide = true
							levelHeadPlatform.Transparency = 1
							levelHeadPlatform.Parent = Workspace
						end

						local overheadCFrame = targetPart.CFrame + Vector3.new(0, 10, 0)
						levelHeadPlatform.CFrame = overheadCFrame
						hrp.CFrame = overheadCFrame + Vector3.new(0, 1.5, 0)
						hrp.Velocity = Vector3.new(0, 0, 0)
					end
				else
					if levelHeadPlatform and levelHeadPlatform.Parent then
						levelHeadPlatform:Destroy()
						levelHeadPlatform = nil
					end
				end
			end)
		elseif FeatureStates.ChestFarm.enabled then
			pcall(function()
				local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if not hrp then return end

				local chestPart = getClosestChest()
				if chestPart and chestPart.Parent then
					local chestPos = chestPart.Position
					local posKey = math.floor(chestPos.X) .. "," .. math.floor(chestPos.Y) .. "," .. math.floor(chestPos.Z)
					
					local dist = (chestPos - hrp.Position).Magnitude
					local travelTime = math.max(0.2, dist / (FeatureStates.ChestFarm.speed * 2.5))
					
					local tween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(chestPos + Vector3.new(0, 3, 0))})
					tween:Play()
					tween.Completed:Wait()

					visitedChests[posKey] = true
					task.wait(0.2)
				else
					visitedChests = {}
					task.wait(1)
				end
			end)
		else
			if levelHeadPlatform and levelHeadPlatform.Parent then
				levelHeadPlatform:Destroy()
				levelHeadPlatform = nil
			end
		end
	end
end)

local function getClosestPlayerInFOV()
	local closestTarget = nil
	local shortestDist = FeatureStates.AimbotFOV
	local mousePos = UserInputService:GetMouseLocation()

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local head = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			if head and hum and hum.Health > 0 then
				local screenPos, onScreen = CurrentCamera:WorldToViewportPoint(head.Position)
				if onScreen then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
					if dist < shortestDist then
						shortestDist = dist
						closestTarget = head
					end
				end
			end
		end
	end
	return closestTarget
end

