local visitedDoors = {}
local lastDoorCheck = 0

local function processAutoEventDoors()
	if tick() - lastDoorCheck < 1.5 then return end
	lastDoorCheck = tick()

	pcall(function()
		local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		for _, obj in ipairs(Workspace:GetDescendants()) do
			local nameL = obj.Name:lower()
			if nameL:find("candy") or nameL:find("dulce") or nameL:find("sugar") or nameL:find("treat") then
				local part = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
				if part then
					hrp.CFrame = part.CFrame
					firetouchinterest(hrp, part, 0)
					firetouchinterest(hrp, part, 1)
				end
			end
		end

		local availableDoors = {}
		for _, obj in ipairs(Workspace:GetDescendants()) do
			local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChild("ProximityPrompt", true)
			if prompt and prompt.Enabled then
				local actionText = tostring(prompt.ActionText or ""):lower()
				local objName = tostring(obj.Name or ""):lower()
				
				local isExactInteract = (actionText == "interactuar" or actionText == "interact" or actionText == "interactuar.")
				local isDoorType = objName:find("door") or objName:find("puerta") or obj:IsA("Model") and (obj.Name:lower():find("door") or obj.Name:lower():find("puerta"))
				
				if isExactInteract and isDoorType then
					local part = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
					if part then
						local posKey = math.floor(part.Position.X) .. "," .. math.floor(part.Position.Y) .. "," .. math.floor(part.Position.Z)
						if not visitedDoors[posKey] then
							table.insert(availableDoors, {part = part, prompt = prompt, key = posKey})
						end
					end
				end
			end
		end

		if #availableDoors == 0 then
			visitedDoors = {}
			return
		end

		local chosen = availableDoors[math.random(1, #availableDoors)]
		visitedDoors[chosen.key] = true
		hrp.CFrame = chosen.part.CFrame + Vector3.new(0, 2, 0)
		
		task.wait(math.random(10, 20) / 10)

		pcall(function()
			local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
			if playerGui then
				for _, gui in ipairs(playerGui:GetDescendants()) do
					if gui:IsA("TextButton") or gui:IsA("ImageButton") then
						local txt = tostring(gui.Text or ""):lower()
						if txt:find("trick") or txt:find("treat") or txt:find("recompensa") or txt:find("claim") or txt:find("reward") then
							gui.MouseButton1Click:Fire()
						end
					end
				end
			end
		end)

		fireproximityprompt(chosen.prompt)
	end)
end

