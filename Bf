							levelHeadPlatform.Size = Vector3.new(10, 1, 10)
							levelHeadPlatform.Anchored = true
							levelHeadPlatform.CanCollide = true
							levelHeadPlatform.Transparency = 1
							levelHeadPlatform.Parent = Workspace
